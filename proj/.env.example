# Set these in Vercel > Project > Settings > Environment Variables (NEVER in frontend files, NEVER commit real values)
SUPABASE_URL=https://sdzdfzhmomfocsvlddli.supabase.co
SUPABASE_SERVICE_ROLE_KEY=put-the-service-role-key-here-server-only
CRON_SECRET=make-a-long-random-string

# Phone notifications. Make the 3 values once with:  node scripts/make-vapid-keys.js
VAPID_PUBLIC_KEY=put-the-public-key-here
VAPID_PRIVATE_KEY=put-the-private-key-here-server-only
VAPID_SUBJECT=mailto:your-email@example.com

# Daking AI (the chat button on the home page). Run ai-chats.sql once in Supabase first.
DAKING_API_URL=https://daking-ai.vercel.app/api/chat
DAKING_DAILY_LIMIT=40
# optional but recommended: the same random string must also be set on the Daking AI project (see daking-ai-patch)
DAKING_PARTNER_SECRET=make-a-long-random-string
